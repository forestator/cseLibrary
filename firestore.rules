rules_version = '2';

// Catalogue data is public (read-only for visitors); writes need a signed-in admin.
// The UID lists mirror services/firebase/authentification.service.ts: keep both in sync.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    function isSuperAdmin() {
      return signedInUid() in [
        'OBWB7BXsEHPYmauZ6NqwEzcuc0x2',
        'WYf433kVzQUmHHRrEM1Th7eESvH3',
        'h0F4SqDlGWXgHAjesEQRzExYN3c2',
        'bcCO7BDwU1hvnDjKMNb2GvRwI1Y2',
        'UCugwOtt4cVGffoIkzoxYJpgQe93',
        'whXa5tBO1VZQhCWRhO1gYbcJmrH3'
      ];
    }

    function isLudoAdmin() {
      return isSuperAdmin() || signedInUid() == 'TtUtjCQZW8cE51IBltKf1LzjxW42';
    }

    function isBricolageAdmin() {
      return isSuperAdmin() || signedInUid() == 'ls9tc3kKxeRlkaXAccs0qk9T9oA2';
    }

    function isNautismeAdmin() {
      return isSuperAdmin() || signedInUid() == 'x4jVMSuZwKZR8ECj6UsxsMLvVAn1';
    }

    function isSonoAdmin() {
      return isSuperAdmin() || signedInUid() == 'h1YOMupBxBTdKBAuCGJFryqE4n72';
    }

    function mayLog(commission) {
      return isSuperAdmin()
        || (commission == 'ludotheque' && isLudoAdmin())
        || (commission == 'bricolage' && isBricolageAdmin())
        || (commission == 'nautisme' && isNautismeAdmin())
        || (commission == 'sonotheque' && isSonoAdmin());
    }

    // Journal of the changes made from the administration: append-only, written by the administrator who made the
    // change (their own uid, the server's clock, a commission they manage), read by the super-administrators.
    match /journal/{entry} {
      allow read: if isSuperAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['at', 'uid', 'email', 'action', 'commission', 'collection', 'collectionLabel', 'itemName', 'summary', 'changes', 'count', 'names'])
        && request.resource.data.uid == signedInUid()
        && request.resource.data.at == request.time
        && mayLog(request.resource.data.commission)
        && request.resource.data.summary.size() <= 500;
      allow update, delete: if false;
    }

    // Choices made in the reconciliation with a catalogue export (lines never to be proposed again).
    match /reconciliation/{document} {
      allow read, write: if isSuperAdmin();
    }

    match /ludotheque/{library} {
      allow read: if true;
      allow write: if isLudoAdmin();
    }

    match /bibliotheque/{library} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /categories/{category} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    match /commissions/bricolage {
      allow read: if true;
      allow write: if isBricolageAdmin();
    }

    match /commissions/nautisme {
      allow read: if true;
      allow write: if isNautismeAdmin();
    }

    match /commissions/sonotheque {
      allow read: if true;
      allow write: if isSonoAdmin();
    }

    match /commissions/photo {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

  }
}
